# Playwright is installed only to run tools/verify-page.mjs, a local
# one-off browser check. It is deliberately NOT a project dependency —
# the site itself has zero npm dependencies and no build step, and that
# must stay true. Installed with:
#   npm install --no-save --no-package-lock playwright
node_modules/

# Local scratch
*.log
.DS_Store
Thumbs.db
.shots/


# Built by tools/blog-build.mjs on every deploy
blog/
sitemap.xml
.agents
.codex
.opencode
skills-lock.json

# Keep agent/skill files local, but allow GitHub workflows.
.github/*
!.github/workflows/
!.github/workflows/*.yml

# Backend build output and local secrets
backend/node_modules/
backend/dist/
backend/.env
backend/.env.import
backend/coverage/

# Staged frontend artifact for GitHub Pages
_site/
