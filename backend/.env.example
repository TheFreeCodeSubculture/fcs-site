NODE_ENV=development
HOST=127.0.0.1
PORT=5050

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://fcs_app:CHANGE_ME@127.0.0.1:5432/fcs

# Generated secrets
JWT_SECRET=CHANGE_ME
REFRESH_TOKEN_PEPPER=CHANGE_ME

# Browser origins allowed to call the API
SITE_ORIGINS=http://localhost:8000

# Public address of this API
PUBLIC_API_URL=http://localhost:5050

# Where reset and invite links send people
PUBLIC_SITE_URL=https://thefreecodesubculture.github.io/fcs-site

# Uploaded member photos
MEDIA_DIR=./media

# Email
GMAIL_USER=CHANGE_ME
GMAIL_APP_PASSWORD=CHANGE_ME
MAIL_FROM_NAME="The Free Code Subculture"

# GitHub integrations
GITHUB_ASSETS_TOKEN=CHANGE_ME
GITHUB_DISPATCH_TOKEN=CHANGE_ME

# Optional: read the organisation's public repositories for the site's
# Projects section. A token raises GitHub's 60 req/hr anonymous limit to
# 5,000. Leave blank to stay unauthenticated; either way the backend
# caches the result for 10 minutes.
GITHUB_ORG=TheFreeCodeSubculture
GITHUB_READ_TOKEN=

# Optional: cover picker
UNSPLASH_ACCESS_KEY=CHANGE_ME

BCRYPT_ROUNDS=12
TRUST_PROXY=0
